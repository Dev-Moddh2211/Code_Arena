# Project & API Configuration
PROJECT_NAME="Code Arena"
VERSION="2.0.0"
API_V1_STR="/api"

# Database (defaults to SQLite; PostgreSQL for production)
DATABASE_URL="sqlite:///./arena.db"
# DATABASE_URL="postgresql://arena_user:arena_password@localhost:5432/code_arena"

# JWT Authentication
JWT_SECRET_KEY="arena_super_secret_jwt_key_change_in_production_987654321"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Origins (comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Online Judge Engine Defaults
JUDGE_DEFAULT_TIMEOUT_MS=2000
JUDGE_DEFAULT_MEMORY_MB=256

# Pre-seeded Demo Accounts
ADMIN_SEED_EMAIL="admin@codearena.dev"
ADMIN_SEED_PASSWORD="AdminPass123!"
SEED_DEMO_DATA=true
